#
# run
#
# Created on: Oct 18, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#

# Usage: run [--update] <build directory of test/libc-test> <expected file>
#
# Runs every libc-test executable whose manifest status is "run", writes
# "<suite>/<name> PASS|FAIL|TIMEOUT" lines to results.txt in the build
# directory, and compares them with the expected file:
#
#   - PASS -> anything else is a regression and fails the run;
#   - a test missing from the expected file must pass, or the run fails
#     (record known failures in the baseline);
#   - anything else -> PASS is an improvement and is reported.
#
# --update rewrites the expected file from the results, but only when there is
# no regression (a PASS -> FAIL is never accepted into the baseline).
#
# TARGET_RUNNER (e.g. qemu-arm) prefixes every execution and
# LIBC_TEST_TIMEOUT (default 10) bounds each test in seconds.

update=false
if [[ $1 == --update ]]; then
	update=true
	shift
fi

build_dir=$(realpath "$1")
expected=$2
manifest=${PROJECT_ROOT:?}/test/libc-test/manifest.txt
results=${build_dir}/results.txt
timeout=${LIBC_TEST_TIMEOUT:-10}

declare -A baseline
if [[ -f ${expected} ]]; then
	while read -r name status; do
		[[ -z ${name} || ${name} == \#* ]] && continue
		baseline[${name}]=${status}
	done < "${expected}"
fi

: > "${results}.tmp"
for name in $(awk '$1 !~ /^#/ && $2 == "run" { print $1 }' "${manifest}" | sort); do
	elf=${build_dir}/${name}.elf
	log=${build_dir}/${name}.log

	if [[ ! -x ${elf} ]]; then
		echo "missing ${elf}" > "${log}"
		status=FAIL
	else
		timeout "${timeout}" ${TARGET_RUNNER:-} "${elf}" > "${log}" 2>&1
		case $? in
			0) status=PASS ;;
			124) status=TIMEOUT ;;
			*) status=FAIL ;;
		esac
	fi

	echo "${name} ${status}" >> "${results}.tmp"
done
mv "${results}.tmp" "${results}"

passed=0
failed=0
regressions=0
while read -r name status; do
	want=${baseline[${name}]:-}

	if [[ ${status} == PASS ]]; then
		passed=$((passed + 1))
		[[ -n ${want} && ${want} != PASS ]] && echo "improvement ${name} (${want} -> PASS)"
		[[ -z ${want} ]] && echo "improvement ${name} (new -> PASS)"
		continue
	fi

	failed=$((failed + 1))
	if [[ ${want} == PASS ]]; then
		echo "regression ${name} (PASS -> ${status}, log ${build_dir}/${name}.log)"
		sed 's/^/    /' "${build_dir}/${name}.log"
		regressions=$((regressions + 1))
	elif [[ -z ${want} ]]; then
		echo "unrecorded ${name} (${status}, log ${build_dir}/${name}.log); record known failures in ${expected}"
		sed 's/^/    /' "${build_dir}/${name}.log"
		regressions=$((regressions + 1))
	fi
done < "${results}"

for name in "${!baseline[@]}"; do
	grep -q "^${name} " "${results}" || echo "note ${name} is in ${expected} but no longer run"
done

echo "libc-test: ${passed} passed, ${failed} failed, ${regressions} regressions (results ${results})"

if ${update}; then
	if [[ ${regressions} -ne 0 ]]; then
		echo "not updating ${expected}: fix the regressions first"
	else
		cp "${results}" "${expected}"
		echo "updated ${expected}"
	fi
fi

[[ ${regressions} -eq 0 ]]
