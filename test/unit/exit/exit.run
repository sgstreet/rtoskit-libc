# Usage: exit.run <exit.elf>

elf=$1
status=0

expect() {
	local mode=$1 want_status=$2 want_output=$3 output code
	output=$(${TARGET_RUNNER:-} "${elf}" "${mode}")
	code=$?
	output=$(echo -n "${output}" | tr '\n' ' ')
	if [[ ${code} -ne ${want_status} || ${output} != "${want_output}" ]]; then
		echo "fail: ${mode}: status ${code}, output '${output}', want ${want_status}, '${want_output}'"
		status=1
	fi
}

expect atexit 5 "registers late second first destructor"
expect quick 7 "second quick"
expect limit 0 "full destructor"

[[ ${status} -eq 0 ]] && echo "pass: exit.run"
exit ${status}
