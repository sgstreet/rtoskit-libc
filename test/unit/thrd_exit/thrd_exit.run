# thrd_exit.run
#
# Created on: Oct 19, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#

# Usage: thrd_exit.run <thrd_exit.elf>
#
# The initial thread calls thrd_exit while a worker runs: the program must
# end with status 0 (EXIT_SUCCESS, not the thread's result 3) after the
# worker, with the atexit handler run and all output flushed.

elf=$1
expected=$'main exiting\nworker done\natexit handler ran'

output=$(${TARGET_RUNNER:-} "${elf}")
status=$?
if [[ ${status} -ne 0 ]]; then
	echo "fail: status ${status}, want 0"
	exit 1
fi
if [[ ${output} != "${expected}" ]]; then
	echo "fail: output:"
	echo "${output}"
	exit 1
fi
echo "pass: thrd_exit.run"
