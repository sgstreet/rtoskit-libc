# smoke.run
#
# Created on: Oct 18, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#

# Usage: smoke.run <smoke.elf>
# Runs the in-process checks, then confirms exit statuses reach the parent.

elf=$1
${TARGET_RUNNER:-} "${elf}" || exit 1

for status in 0 1 42 255; do
	${TARGET_RUNNER:-} "${elf}" exit ${status}
	actual=$?
	if [[ ${actual} -ne ${status} ]]; then
		echo "fail: exit(${status}) gave status ${actual}"
		exit 1
	fi
	echo "pass: exit(${status}) status reaches the parent"
done
