# Usage: run-unit <build directory of test/unit>
#
# Runs every unit test executable below the build directory. A test passes
# when it exits with status 0. When the test's source directory contains an
# executable <name>.run, that script is run with the executable's path instead
# and decides the outcome. TARGET_RUNNER (e.g. a qemu command) prefixes every
# execution.

build_dir=$(realpath "$1")
source_dir=${PROJECT_ROOT:?}/test/unit
passed=0
failed=0

for elf in $(find "${build_dir}" -name '*.elf' | sort); do
	name=$(basename "${elf}" .elf)
	relative=$(dirname "${elf#${build_dir}/}")
	driver=${source_dir}/${relative}/${name}.run
	log=${elf%.elf}.log

	if [[ -x ${driver} ]]; then
		TARGET_RUNNER=${TARGET_RUNNER:-} timeout 60 "${driver}" "${elf}" > "${log}" 2>&1
	else
		timeout 60 ${TARGET_RUNNER:-} "${elf}" > "${log}" 2>&1
	fi
	status=$?

	if [[ ${status} -eq 0 ]]; then
		echo "pass ${relative}/${name}"
		passed=$((passed + 1))
	else
		echo "fail ${relative}/${name} (status ${status}, log ${log})"
		sed 's/^/    /' "${log}"
		failed=$((failed + 1))
	fi
done

echo "unit tests: ${passed} passed, ${failed} failed"
[[ ${failed} -eq 0 && ${passed} -gt 0 ]]
