# Usage: none.run <none.elf>
#
# The port/none program reports its checks from an atexit handler, which
# only runs if thrd_exit in main ended the program as exit(EXIT_SUCCESS).

elf=$1

output=$(${TARGET_RUNNER:-} "${elf}")
status=$?
echo "${output}"
if [[ ${status} -ne 0 ]]; then
	echo "fail: status ${status}, want 0"
	exit 1
fi
[[ ${output} == "pass: none" ]]
