# bench-runner
#
# Created on: Oct 20, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#
# The phase 3 benchmark measurements (PLAN D72, docs/research/benchmarks.md).
# Run from the project root after a release build and "make setup-bench"
# ("make bench" does all three):
#
#   tools/scripts/bench-runner [--build-type T] run [--board B ...]
#                                                        measure; write results.json in the build
#                                                        (release: the size flavour, the default;
#                                                        speed: the speed flavour, PLAN D73)
#   tools/scripts/bench-runner diff [--board B ...]      compare results.json with docs/perf/baseline-<arch>[-speed].json;
#                                                        exit status 1 when a case regressed
#   tools/scripts/bench-runner report [--board B ...]    write the baselines from results.json
#   tools/scripts/bench-runner markdown --board B [--previous REF | --against FILE]
#                                                        print the summary tables of a baseline, against
#                                                        the baseline at git revision REF, or the baseline
#                                                        file FILE (<arch> replaced), if given
#   tools/scripts/bench-runner compare [--board B ...] [--work DIR]
#                                                        build the test/bench programs against picolibc and
#                                                        newlib-nano (the packages of size-report compare),
#                                                        count them the same way and print a Markdown table
#                                                        beside the baselines (context, not a gate; P3.06)
#   tools/scripts/bench-runner aor [--board B ...] [--record | --from-record]
#                                                        relink the speed build's programs with Arm Optimized
#                                                        Routines ("make aor" first), count them and print the
#                                                        tables against the baselines; --record keeps the results
#                                                        in docs/perf/aor-<arch>.json (P4.03, PLAN D92)
#
# Figures: per case of each test/bench program, the guest instructions per
# operation counted by the qemu plugin tools/qemu-plugins/bench-roi.c (on
# every board; x86_64 runs under qemu-x86_64 for this), and on x86_64 the
# time stamp counter cycles per operation of a native run (the fastest of 15, see
# test/bench/harness/bench.h). Instruction counts are exact and repeatable,
# so they are what diff gates; cycles are reported, not gated.

import argparse
import glob
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import shutil
import subprocess
import sys

BOARDS = ['linux-x86_64', 'linux-armv6-m', 'linux-armv6s-m', 'linux-armv7e-m', 'linux-armv7e-m-dp', 'linux-armv8-m.main']
PROGRAMS = ['string', 'stdio', 'strto', 'malloc', 'malloc-tiny', 'qsort', 'math', 'softfloat', 'threads']
QEMU_VERSION = '8.2.2'
QEMU_ROOT = os.path.join('local', f'qemu-{QEMU_VERSION}')
PLUGIN = os.path.join(QEMU_ROOT, 'lib', 'bench-roi.so')

# A case regresses when its count grows by more than both of these
REGRESSION_RATIO = 0.01
REGRESSION_INSNS = 2.0

# The string sweep is summarised at these sizes; the full sweep stays in the JSON
SUMMARY_SIZES = [0, 1, 4, 16, 64, 256, 1024]
STRING_FUNCTIONS = ['memcpy', 'memmove-down', 'memmove-up', 'memset', 'memcmp', 'memchr', 'strlen', 'strchr', 'strcmp', 'strcpy']


def arch_of(board):
	return board[len('linux-'):]


def is_arm(board):
	return arch_of(board) != 'x86_64'


def program_path(build, program):
	return os.path.join(build, 'test', 'bench', program, f'bench-{program}.elf')


def results_path(build):
	return os.path.join(build, 'test', 'bench', 'results.json')


def flavour_of(build_type):
	"""The speed build type is the speed flavour (PLAN D73); release (and debug) are the size flavour."""
	return 'speed' if build_type == 'speed' else 'size'


def baseline_path(directory, board, build_type):
	suffix = '-speed' if flavour_of(build_type) == 'speed' else ''
	return os.path.join(directory, f'baseline-{arch_of(board)}{suffix}.json')


def symbol_addresses(board, elf, names):
	nm = os.path.join('local', 'bin', 'arm-none-eabi-nm') if is_arm(board) else 'nm'
	output = subprocess.run([nm, elf], check=True, capture_output=True, text=True).stdout
	addresses = {}
	for line in output.splitlines():
		fields = line.split()
		if len(fields) == 3 and fields[2] in names:
			addresses[fields[2]] = int(fields[0], 16)
	if is_arm(board):
		# A Thumb function symbol has bit 0 set; its first instruction is at the even address
		addresses = {name: address & ~1 for name, address in addresses.items()}
	missing = set(names) - set(addresses)
	if missing:
		raise SystemExit(f'{elf}: no symbol {", ".join(sorted(missing))}')
	return addresses


def parse_cases(text, elf):
	cases = []
	for line in text.splitlines():
		match = re.fullmatch(r'bench (\S+) (\d+) (\d+)', line)
		if match:
			cases.append((match.group(1), int(match.group(2)), int(match.group(3))))
	if not cases or cases[0][0] != '@overhead':
		raise SystemExit(f'{elf}: no calibration case in the output')
	names = [name for name, _, _ in cases]
	duplicates = sorted({name for name in names if names.count(name) > 1})
	if duplicates:
		raise SystemExit(f'{elf}: case names used twice: {", ".join(duplicates)}')
	return cases


def count_instructions(board, elf):
	addresses = symbol_addresses(board, elf, ['bench_roi_begin', 'bench_roi_end'])
	qemu = os.path.join(QEMU_ROOT, 'bin', 'qemu-arm' if is_arm(board) else 'qemu-x86_64')
	plugin = f'{PLUGIN},begin={addresses["bench_roi_begin"]:#x},end={addresses["bench_roi_end"]:#x}'
	command = [qemu] + (['-cpu', 'max'] if is_arm(board) else []) + ['-plugin', plugin, '-d', 'plugin', elf, 'count']
	run = subprocess.run(command, capture_output=True, text=True, timeout=1800)
	if run.returncode != 0:
		raise SystemExit(f'{elf}: exit status {run.returncode}\n{run.stderr}')
	cases = parse_cases(run.stdout, elf)
	counts = [int(m) for m in re.findall(r'^bench-roi (\d+)$', run.stderr, re.MULTILINE)]
	if len(counts) != len(cases):
		raise SystemExit(f'{elf}: {len(cases)} cases but {len(counts)} regions')
	overhead = counts[0]
	return {name: round((count - overhead) / operations, 2) for (name, operations, _), count in zip(cases[1:], counts[1:])}


def time_cycles(elf):
	# Pinned to one CPU when taskset exists, so the time stamp counter and the caches stay put
	command = (['taskset', '-c', '0'] if shutil.which('taskset') else []) + [elf, 'time']
	run = subprocess.run(command, capture_output=True, text=True, timeout=1800)
	if run.returncode != 0:
		raise SystemExit(f'{elf}: exit status {run.returncode}\n{run.stderr}')
	return {name: round(cycles / operations, 2) for name, operations, cycles in parse_cases(run.stdout, elf)[1:]}


def measure(board, build_type, build_root):
	build = os.path.join(build_root, board, build_type)
	result = {'arch': arch_of(board), 'board': board, 'build_type': build_type, 'flavour': flavour_of(build_type), 'qemu': QEMU_VERSION, 'programs': {}}
	for program in PROGRAMS:
		elf = program_path(build, program)
		if not os.path.exists(elf):
			raise SystemExit(f'{elf}: not built (make BOARD_TYPE={board} BUILD_TYPE={build_type})')
		cases = {name: {'insns': insns} for name, insns in count_instructions(board, elf).items()}
		if not is_arm(board):
			for name, cycles in time_cycles(elf).items():
				cases[name]['cycles'] = cycles
		result['programs'][program] = cases
	return result


def write_json(path, data):
	with open(path, 'w') as f:
		json.dump(data, f, indent=1, sort_keys=True)
		f.write('\n')


def read_json(path):
	with open(path) as f:
		return json.load(f)


def check_tools():
	missing = [p for p in (os.path.join(QEMU_ROOT, 'bin', 'qemu-arm'), os.path.join(QEMU_ROOT, 'bin', 'qemu-x86_64'), PLUGIN) if not os.path.exists(p)]
	if missing:
		raise SystemExit(f'{", ".join(missing)}: missing; "make bench" builds them (setup-bench)')


def command_run(args):
	check_tools()
	for board in args.board:
		build = os.path.join(args.build_root, board, args.build_type)
		result = measure(board, args.build_type, args.build_root)
		write_json(results_path(build), result)
		print(f'{results_path(build)}: {sum(len(c) for c in result["programs"].values())} cases')
	return 0


def compare(old, new):
	"""The cases whose instruction count changed: (program, case, old, new), and the cases only in one."""
	changed = []
	only = []
	for program in sorted(set(old['programs']) | set(new['programs'])):
		before = old['programs'].get(program, {})
		after = new['programs'].get(program, {})
		for case in sorted(set(before) | set(after)):
			if case not in before or case not in after:
				only.append((program, case, 'baseline' if case in before else 'build'))
			elif before[case]['insns'] != after[case]['insns']:
				changed.append((program, case, before[case]['insns'], after[case]['insns']))
	return changed, only


def regressed(old, new):
	return new - old > REGRESSION_INSNS and new > old * (1 + REGRESSION_RATIO)


def command_diff(args):
	failed = False
	for board in args.board:
		build = os.path.join(args.build_root, board, args.build_type)
		baseline = read_json(baseline_path(args.baseline_dir, board, args.build_type))
		changed, only = compare(baseline, read_json(results_path(build)))
		worse = [c for c in changed if regressed(c[2], c[3])]
		better = [c for c in changed if c[3] < c[2]]
		print(f'{board}: {len(better)} faster, {len(worse)} regressed, {len(changed) - len(better) - len(worse)} within noise, {len(only)} added or removed')
		for program, case, old, new in sorted(changed, key=lambda c: (c[3] - c[2]) / max(c[2], 1)):
			if args.verbose or (program, case, old, new) in worse:
				mark = ' REGRESSED' if (program, case, old, new) in worse else ''
				print(f'  {program}/{case}: {old:g} -> {new:g} ({(new - old) / max(old, 1) * 100:+.1f} %){mark}')
		for program, case, where in only:
			print(f'  {program}/{case}: only in the {where}')
		failed |= bool(worse)
	return 1 if failed else 0


def command_report(args):
	for board in args.board:
		build = os.path.join(args.build_root, board, args.build_type)
		result = read_json(results_path(build))
		path = baseline_path(args.baseline_dir, board, args.build_type)
		write_json(path, result)
		print(f'{path}: {sum(len(c) for c in result["programs"].values())} cases')
	return 0


def previous_baseline(revision, path):
	run = subprocess.run(['git', 'show', f'{revision}:{path}'], capture_output=True, text=True)
	return json.loads(run.stdout) if run.returncode == 0 else None


def figure(cases, case, key='insns'):
	value = cases.get(case, {}).get(key)
	if value is None:
		return '—'
	return f'{value:.0f}' if value >= 100 else f'{value:.1f}'


def with_change(cases, before, case):
	text = figure(cases, case)
	if before is None or case not in before or case not in cases or before[case]['insns'] == cases[case]['insns']:
		return text
	old = before[case]['insns']
	return f'{text} ({(cases[case]["insns"] - old) / max(old, 1) * 100:+.0f} %)'


def string_summary(cases, before):
	"""Function x size: the aligned case, then the worst of the misaligned ones."""
	lines = ['| Function | ' + ' | '.join(str(s) for s in SUMMARY_SIZES) + ' |', '|---|' + '---:|' * len(SUMMARY_SIZES)]
	for function in STRING_FUNCTIONS:
		cells = []
		for size in SUMMARY_SIZES:
			prefix = f'{function}/{size}/'
			aligned = prefix + ('0:0' if f'{prefix}0:0' in cases else '0')
			others = [c for c in cases if c.startswith(prefix) and c != aligned]
			worst = max(others, key=lambda c: cases[c]['insns']) if others else None
			cells.append(with_change(cases, before, aligned) + (f' / {figure(cases, worst)}' if worst else ''))
		lines.append(f'| `{function}` | ' + ' | '.join(cells) + ' |')
	for case in sorted(c for c in cases if c.startswith('mix/')):
		lines.append(f'| `{case}` (per call) | ' + with_change(cases, before, case) + ' |' + ' |' * (len(SUMMARY_SIZES) - 1))
	return lines


def case_table(cases, before, cycles):
	lines = ['| Case | insns/op |' + (' cycles/op |' if cycles else ''), '|---|---:|' + ('---:|' if cycles else '')]
	for case in cases:
		lines.append(f'| `{case}` | {with_change(cases, before, case)} |' + (f' {figure(cases, case, "cycles")} |' if cycles else ''))
	return lines


def math_table(cases, before, cycles):
	"""One row per function: float and double throughput, and their latency where cycles were measured."""
	functions = []
	for case in cases:
		name = case.split('/')[0]
		base = name[:-1] if name.endswith('f') and f'{name[:-1]}/throughput' in cases else name
		if base not in functions:
			functions.append(base)
	header = '| Function | float | double |' + (' float cycles (thr / lat) | double cycles (thr / lat) |' if cycles else '')
	lines = [header, '|---|---:|---:|' + ('---:|---:|' if cycles else '')]
	for base in functions:
		row = f'| `{base}` | {with_change(cases, before, f"{base}f/throughput")} | {with_change(cases, before, f"{base}/throughput")} |'
		if cycles:
			row += f' {figure(cases, f"{base}f/throughput", "cycles")} / {figure(cases, f"{base}f/latency", "cycles")} |'
			row += f' {figure(cases, f"{base}/throughput", "cycles")} / {figure(cases, f"{base}/latency", "cycles")} |'
		lines.append(row)
	return lines


def command_markdown(args):
	for board in args.board:
		path = baseline_path(args.baseline_dir, board, args.build_type)
		data = read_json(path)
		if args.against:
			previous = read_json(args.against.replace('<arch>', arch_of(board)))
		else:
			previous = previous_baseline(args.previous, path) if args.previous else None
		cycles = not is_arm(board)
		print(f'Instructions per operation (qemu {data["qemu"]}, {data["build_type"]}, {data["flavour"]} flavour)' + (f', change against {args.previous or args.against.replace("<arch>", arch_of(board))}' if previous else '') + '.\n')
		for program in [p for p in PROGRAMS if p in data['programs']]:
			cases = data['programs'][program]
			before = previous['programs'].get(program) if previous else None
			print(f'### {program}\n')
			if program == 'string':
				lines = string_summary(cases, before)
				print('Aligned / worst of the misaligned offsets.\n')
			elif program == 'math':
				lines = math_table(cases, before, cycles)
				print('Throughput, per call (the latency counts are the same under qemu).\n')
			else:
				lines = case_table(cases, before, cycles)
			print('\n'.join(lines) + '\n')
	return 0


# Comparison with picolibc and newlib-nano (P3.06): the same benchmark sources, built against each
# library with the shims of tools/bench-compare (Linux write and exit, a static heap), run under the same
# qemu and plugin. malloc-tiny is rtoskit's own allocator and threads needs <threads.h>, so neither is compared.
COMPARE_PROGRAMS = ['string', 'stdio', 'strto', 'malloc', 'qsort', 'math']
COMPARE_LIBRARIES = ['picolibc', 'newlib-nano']
COMPARE_FLAGS = ['-Os', '-std=gnu23', '-fno-builtin', '-fno-tree-loop-distribute-patterns', '-ffunction-sections', '-fdata-sections']

# The cases the table shows; every common case enters the geometric means
COMPARE_CASES = {
	'string': ['memcpy/16/0:0', 'memcpy/1024/0:0', 'memset/1024/0', 'strlen/64/0', 'strcmp/64/0:0'],
	'stdio': ['snprintf/%d', 'snprintf/%s', 'snprintf/%f', 'snprintf/%g', 'fprintf/mix'],
	'strto': ['strtol/int', 'strtod/short', 'strtod/17-digits'],
	'malloc': ['fixed/16', 'batch/shuffled', 'realloc/grow'],
	'qsort': ['qsort/random/1024'],
	'math': ['sqrtf/throughput', 'expf/throughput', 'logf/throughput', 'sinf/throughput', 'powf/throughput', 'erff/throughput', 'exp/throughput', 'log/throughput', 'sin/throughput', 'pow/throughput'],
}


def size_report():
	loader = importlib.machinery.SourceFileLoader('size_report', os.path.join('tools', 'scripts', 'size-report'))
	module = importlib.util.module_from_spec(importlib.util.spec_from_loader('size_report', loader))
	loader.exec_module(module)
	return module


def compare_build(report, roots, library, board, program, work):
	gcc = os.path.abspath(os.path.join('local', 'bin', 'arm-none-eabi-gcc'))
	arch = arch_of(board)
	flags = report.cross_flags(arch) + COMPARE_FLAGS + ['-I' + os.path.join('test', 'bench', 'harness')]
	sources = [os.path.join('tools', 'bench-compare', 'start.S'), os.path.join('tools', 'bench-compare', 'picolibc.c' if library == 'picolibc' else 'newlib.c'),
		   os.path.join('test', 'bench', 'harness', 'bench.c'), os.path.join('test', 'bench', program, program + '.c')]
	directory = os.path.join(work, library, arch)
	os.makedirs(directory, exist_ok=True)
	elf = os.path.join(directory, f'bench-{program}.elf')
	link = ['-static', '-Wl,--gc-sections', '-Wl,--no-warn-rwx-segments', '-Wl,--no-warn-execstack']
	if library == 'picolibc':
		# picolibc's own linker script, with room for the heap; qemu loads every segment at its address
		prefix = os.path.join(roots['picolibc'], 'usr')
		command = [gcc] + flags + [f'--specs={prefix}/lib/picolibc/arm-none-eabi/picolibc.specs', f'--picolibc-prefix={prefix}', '-nostartfiles',
					   '-Wl,--defsym=__flash=0x10000', '-Wl,--defsym=__flash_size=0x400000', '-Wl,--defsym=__ram=0x1000000', '-Wl,--defsym=__ram_size=0x1000000'] + link + ['-o', elf] + sources + ['-lm']
	else:
		# newlib-nano formats floating point only when asked to (the stdio cases use it)
		usr = os.path.join(roots['newlib'], 'usr')
		include = os.path.join(roots['newlib-dev'], 'usr', 'include', 'newlib')
		multilib = subprocess.run([gcc] + flags + ['-print-multi-directory'], stdout=subprocess.PIPE, text=True, check=True).stdout.strip()
		libdir = os.path.join(usr, 'lib', 'arm-none-eabi', 'newlib', multilib)
		gcc_include = subprocess.run([gcc, '-print-file-name=include'], stdout=subprocess.PIPE, text=True, check=True).stdout.strip()
		command = [gcc] + flags + ['-nostdinc', '-isystem', include + '/nano', '-isystem', include, '-isystem', gcc_include, '-nostdlib', '-Wl,-T,' + os.path.join('port', 'linux', 'arm', 'headers.ld')] + link + \
			['-u', '_printf_float', '-u', '_scanf_float', '-o', elf] + sources + ['-L' + libdir, '-Wl,--start-group', '-lc_nano', '-lm', '-lnosys', '-lgcc', '-Wl,--end-group']
	result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
	if result.returncode != 0:
		raise SystemExit(' '.join(command) + '\n' + result.stdout)
	return elf


def geometric_mean(ratios):
	return math.exp(sum(math.log(r) for r in ratios) / len(ratios)) if ratios else float('nan')


def command_compare(args):
	check_tools()
	report = size_report()
	os.makedirs(args.work, exist_ok=True)
	roots = report.fetch_packages(args.work)
	for board in [b for b in args.board if is_arm(b)]:
		arch = arch_of(board)
		ours = {flavour: read_json(baseline_path(args.baseline_dir, board, build_type))['programs'] for flavour, build_type in (('size', 'release'), ('speed', 'speed'))}
		theirs = {}
		for library in COMPARE_LIBRARIES:
			theirs[library] = {program: count_instructions(board, compare_build(report, roots, library, board, program, args.work)) for program in COMPARE_PROGRAMS}
			write_json(os.path.join(args.work, library, arch, 'results.json'), theirs[library])
		print(f'### {arch}\n')
		print('Instructions per operation; the geometric mean is over every case all four builds share, as a ratio to rtoskit\'s speed flavour.\n')
		print('| Program | Case | rtoskit (size) | rtoskit (speed) | picolibc | newlib-nano |')
		print('|---|---|---:|---:|---:|---:|')
		for program in COMPARE_PROGRAMS:
			common = [case for case in ours['speed'][program] if case in ours['size'][program] and all(case in theirs[library][program] for library in COMPARE_LIBRARIES)]
			means = [geometric_mean([source[program][case]['insns'] / ours['speed'][program][case]['insns'] if isinstance(source[program][case], dict) else source[program][case] / ours['speed'][program][case]['insns']
						 for case in common if ours['speed'][program][case]['insns'] > 0]) for source in (ours['size'], ours['speed'], theirs['picolibc'], theirs['newlib-nano'])]
			print(f'| {program} | geometric mean ({len(common)} cases) | ' + ' | '.join(f'{m:.2f}' for m in means) + ' |')
			for case in COMPARE_CASES[program]:
				if case not in common:
					continue
				figures = [ours['size'][program][case]['insns'], ours['speed'][program][case]['insns'], theirs['picolibc'][program][case], theirs['newlib-nano'][program][case]]
				print(f'| | `{case}` | ' + ' | '.join(f'{f:.0f}' if f >= 100 else f'{f:.1f}' for f in figures) + ' |')
		print()
	return 0


# Comparison with Arm Optimized Routines (P4.03, PLAN D92, D93): the objects of the speed build's
# test/bench programs relinked by tools/scripts/aor-build with AOR's string, math (-O3) and fp archives
# ahead of libc.a, so that only the routines AOR provides change; counted the same way. malloc-tiny
# links another archive and threads uses nothing AOR has, so neither is compared.
AOR_PROGRAMS = ['string', 'stdio', 'strto', 'malloc', 'qsort', 'math', 'softfloat']
AOR_LIBRARIES = ['string', 'math', 'fp']


def aor_build():
	loader = importlib.machinery.SourceFileLoader('aor_build', os.path.join('tools', 'scripts', 'aor-build'))
	module = importlib.util.module_from_spec(importlib.util.spec_from_loader('aor_build', loader))
	loader.exec_module(module)
	return module


def aor_record_path(directory, board):
	return os.path.join(directory, f'aor-{arch_of(board)}.json')


def aor_measure(aor, board, build_root):
	build = os.path.join(build_root, board, 'speed')
	manifest = aor.read_manifest(build_root, board)
	names = [name for name in AOR_LIBRARIES if name in manifest['provided']]
	libraries = [aor.library_path(build_root, board, name) for name in names]
	provided = [symbol for name in names for symbol in manifest['provided'][name]]
	directory = os.path.join(aor.aor_dir(build_root, board), 'bench')
	os.makedirs(directory, exist_ok=True)
	harness = os.path.join(build, 'test', 'bench', 'harness')
	common = sorted(glob.glob(os.path.join(harness, '*.o'))) + sorted(glob.glob(os.path.join(harness, 'arm' if is_arm(board) else 'x86_64', '*.o')))
	# The JSON is key-sorted, so the run order of the cases, which the tables follow, is kept beside them
	result = {'arch': arch_of(board), 'board': board, 'build_type': 'speed', 'aor': manifest['revision'], 'qemu': QEMU_VERSION, 'programs': {}, 'order': {}, 'substituted': {}}
	for program in AOR_PROGRAMS:
		objects = sorted(glob.glob(os.path.join(build, 'test', 'bench', program, '*.o')))
		if not objects:
			raise SystemExit(f'{build}: test/bench/{program} not built (make BOARD_TYPE={board} BUILD_TYPE=speed)')
		elf = os.path.join(directory, f'bench-{program}.elf')
		mapfile = aor.link(board, build, objects + common, libraries, elf, provided)
		result['substituted'][program] = aor.check_substitution(board, elf, mapfile, provided)
		result['programs'][program] = {name: {'insns': insns} for name, insns in count_instructions(board, elf).items()}
		result['order'][program] = list(result['programs'][program])
		print(f'{elf}: {len(result["programs"][program])} cases, {len(result["substituted"][program])} AOR symbols', file=sys.stderr)
	return result


def ratio_cells(values):
	return ' | '.join('—' if v is None else (f'{v:.0f}' if v >= 100 else f'{v:.1f}') for v in values)


def is_entry_point(symbol):
	"""A routine a program calls, not one of AOR's tables or internal helpers (arm_math_*, __fnan2, ...)."""
	if symbol.startswith('__'):
		return symbol.startswith('__aeabi_') or re.fullmatch(r'__(le|ge)[sd]f2', symbol) is not None
	return not symbol.startswith('arm_math_')


def aor_markdown(board, ours, theirs):
	"""The tables of one board: rtoskit's size and speed flavours and the speed flavour with AOR's routines."""
	lines = [f'### {arch_of(board)}', '', 'Instructions per operation: rtoskit-libc\'s size and speed flavours, and the speed flavour with AOR\'s routines linked in. '
		 'The ratio is AOR against the speed flavour, as a geometric mean over the cases whose count changed.', '',
		 '| Program | Cases changed | AOR / speed (geometric mean) | AOR symbols linked |', '|---|---:|---:|---|']
	for program in AOR_PROGRAMS:
		speed = ours['speed'][program]
		cases = theirs['programs'][program]
		changed = [c for c in cases if c in speed and cases[c]['insns'] != speed[c]['insns'] and speed[c]['insns'] > 0]
		mean = geometric_mean([cases[c]['insns'] / speed[c]['insns'] for c in changed])
		symbols = [s for s in theirs['substituted'][program] if is_entry_point(s)]
		lines.append(f'| {program} | {len(changed)} of {len(cases)} | ' + (f'{mean:.2f}' if changed else '—') + ' | ' + (', '.join(f'`{s}`' for s in symbols) if symbols else '—') + ' |')
	lines.append('')

	string = theirs['programs']['string']
	functions = [f for f in STRING_FUNCTIONS if any(c.startswith(f + '/') and c in ours['speed']['string'] and string[c]['insns'] != ours['speed']['string'][c]['insns'] for c in string)]
	if functions:
		lines += ['#### string', '', 'Aligned case per size: size flavour / speed flavour / AOR.', '',
			  '| Function | ' + ' | '.join(str(s) for s in SUMMARY_SIZES) + ' |', '|---|' + '---:|' * len(SUMMARY_SIZES)]
		for function in functions:
			cells = []
			for size in SUMMARY_SIZES:
				prefix = f'{function}/{size}/'
				case = prefix + ('0:0' if f'{prefix}0:0' in string else '0')
				values = [ours['size']['string'].get(case, {}).get('insns'), ours['speed']['string'].get(case, {}).get('insns'), string.get(case, {}).get('insns')]
				cells.append(' / '.join('—' if v is None else f'{v:.0f}' for v in values))
			lines.append(f'| `{function}` | ' + ' | '.join(cells) + ' |')
		lines.append('')

	math_cases = theirs['programs']['math']
	rows = []
	for case in theirs['order']['math']:
		if not case.endswith('/throughput') or case not in ours['speed']['math'] or math_cases[case]['insns'] == ours['speed']['math'][case]['insns']:
			continue
		rows.append(f'| `{case.split("/")[0]}` | ' + ratio_cells([ours['size']['math'][case]['insns'], ours['speed']['math'][case]['insns'], math_cases[case]['insns']]) + f' | {math_cases[case]["insns"] / ours["speed"]["math"][case]["insns"]:.2f} |')
	if rows:
		lines += ['#### math', '', 'Throughput per call, for the functions whose count changed (AOR\'s own, or ours through AOR\'s soft-float).', '',
			  '| Function | size | speed | AOR | AOR / speed |', '|---|---:|---:|---:|---:|'] + rows + ['']

	soft = theirs['programs']['softfloat']
	lines += ['#### softfloat', '', 'Per operation.', '', '| Operation | size | speed | AOR | AOR / speed |', '|---|---:|---:|---:|---:|']
	for case in theirs['order']['softfloat']:
		values = [ours['size']['softfloat'].get(case, {}).get('insns'), ours['speed']['softfloat'].get(case, {}).get('insns'), soft[case]['insns']]
		ratio = f'{values[2] / values[1]:.2f}' if values[1] else '—'
		lines.append(f'| `{case}` | ' + ratio_cells(values) + f' | {ratio} |')
	lines.append('')
	return lines


def command_aor(args):
	check_tools()
	aor = aor_build()
	for board in args.board:
		if args.from_record:
			theirs = read_json(aor_record_path(args.baseline_dir, board))
		else:
			theirs = aor_measure(aor, board, args.build_root)
			write_json(os.path.join(aor.aor_dir(args.build_root, board), 'bench-results.json'), theirs)
			if args.record:
				write_json(aor_record_path(args.baseline_dir, board), theirs)
		ours = {flavour: read_json(baseline_path(args.baseline_dir, board, build_type))['programs'] for flavour, build_type in (('size', 'release'), ('speed', 'speed'))}
		print('\n'.join(aor_markdown(board, ours, theirs)))
	return 0


def main():
	parser = argparse.ArgumentParser(description='Phase 3 benchmark measurements (PLAN D72)')
	parser.add_argument('--build-type', default='release')
	parser.add_argument('--baseline-dir', default=os.path.join('docs', 'perf'))
	parser.add_argument('--build-root', default='build', help='the OUTPUT_ROOT of the build to measure')
	sub = parser.add_subparsers(dest='command', required=True)
	for name in ('run', 'diff', 'report', 'markdown'):
		p = sub.add_parser(name)
		p.add_argument('--board', action='append', choices=BOARDS)
		if name == 'diff':
			p.add_argument('--verbose', action='store_true', help='list every changed case, not only the regressions')
		if name == 'markdown':
			p.add_argument('--previous', help='a git revision whose baseline to compare with')
			p.add_argument('--against', help='a baseline file to compare with (<arch> is replaced), e.g. the other flavour')
	p = sub.add_parser('compare')
	p.add_argument('--board', action='append', choices=BOARDS)
	p.add_argument('--work', default=os.path.join('build', 'bench-compare'), help='where the packages are unpacked and the programs built')
	p = sub.add_parser('aor')
	p.add_argument('--board', action='append', choices=BOARDS)
	p.add_argument('--record', action='store_true', help='also write the results to docs/perf/aor-<arch>.json')
	p.add_argument('--from-record', action='store_true', help='print the tables of docs/perf/aor-<arch>.json without measuring')
	args = parser.parse_args()
	if getattr(args, 'board', None) is None:
		args.board = BOARDS
	commands = {'run': command_run, 'diff': command_diff, 'report': command_report, 'markdown': command_markdown, 'compare': command_compare, 'aor': command_aor}
	return commands[args.command](args)


if __name__ == '__main__':
	sys.exit(main())
