#!/usr/bin/env python3
#
# Copyright (C) 2026 Red Rocket Computing, LLC
#
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at http://mozilla.org/MPL/2.0/.
#
# annexb-audit
#
# Created on: Oct 19, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#
# Generates test/unit/annexb/annexb.c from the C23 Annex B library summary
# (PLAN D50): run from the project root as
#   tools/scripts/annexb-audit [docs/standard/annex-b.pdf [test/unit/annexb/annexb.c]]
# Needs pdftotext (poppler-utils). Out-of-scope headers (wide and Unicode
# characters) and conditional macros (decimal floating point, Annex K, the
# features defined only when supported) are left out; pseudo-prototypes with
# placeholder types become existence checks.
#
import re
import subprocess
import sys

HEADER = """/*
 * Copyright (C) 2026 Red Rocket Computing, LLC
 *
 * This Source Code Form is subject to the terms of the Mozilla Public
 * License, v. 2.0. If a copy of the MPL was not distributed with this
 * file, You can obtain one at http://mozilla.org/MPL/2.0/.
 *
 * annexb.c
 *
 * Created on: Oct 19, 2026
 *     Author: Stephen Street (stephen@redrocketcomputing.com)
 */

"""
OUT = sys.argv[2] if len(sys.argv) > 2 else 'test/unit/annexb/annexb.c'
PDF = sys.argv[1] if len(sys.argv) > 1 else 'docs/standard/annex-b.pdf'
text = subprocess.run(['pdftotext', '-layout', PDF, '-'], check=True, capture_output=True, text=True).stdout.split('\n')
OUT_OF_SCOPE = {'uchar.h', 'wchar.h', 'wctype.h'}  # wide and Unicode characters (PLAN §1)
sections = []
cur = None
for line in text:
    if re.search(r'© ISO 2024|Library summary — \d+|ISO/IEC 9899:2024 \(en\)|^\s*§ B\.', line):
        continue
    m = re.match(r'\s*B\.(\d+)(?:\.\d+)?\s+.*<([a-z0-9_]+\.h)>', line)
    if m:
        cur = {'header': m.group(2), 'lines': []}
        sections.append(cur)
        continue
    if cur is not None:
        cur['lines'].append(line)

N_PATTERN = re.compile(r'^(PRI|SCN)[bBdiouxX](LEAST|FAST)?N$|^U?INT(_LEAST|_FAST)?N_(MIN|MAX|WIDTH)$|^U?INTN_C$|^u?int(_least|_fast)?N_t$|^atomic_u?int(_least|_fast)?N_t$')
# Defined only when supported or when the program asks (C23 says so for each); not required of this implementation
CONDITIONAL = re.compile(r'^(NDEBUG|__STDC_NO_\w+|imaginary|_Imaginary_I|FE_(DIVBYZERO|INEXACT|INVALID|OVERFLOW|UNDERFLOW|DOWNWARD|UPWARD|TOWARDZERO|TONEARESTFROMZERO|SNANS_ALWAYS_SIGNAL)|FE_DEC_\w+|FP_FAST_\w+|DEC\w*|__STDC_IEC_\w+|__STDC_LIB_EXT1__|errno_t|rsize_t|RSIZE_MAX|constraint_handler_t|__STDC_WANT_\w+)$')
headers, idents, protos, skipped = [], [], [], []
for s in sections:
    hdr = s['header']
    if hdr in OUT_OF_SCOPE:
        continue
    headers.append(hdr)
    in_protos = False
    stop_idents = False
    buf = ''
    for line in s['lines']:
        st = line.strip()
        if not st or st.startswith('#pragma'):
            continue
        if re.match(r'B\.\d+\.\d+', st):
            stop_idents = 'decimal' in st.lower()
            continue
        if re.search(r'^(\d+\s+)?(The following|Only if|N is)', st) or re.search(r'provided only if|additionally', st):
            if re.search(r'__STDC_LIB_EXT1__|__STDC_IEC_60559_DFP__|_DecimalN', st):
                stop_idents = True
            continue
        if '(' not in st and not buf and re.search(r'\b(the|of|if|is|before|inclusion|header|provides|content|defines|only|user|code|ally|implementation|program|macros?)\b', st):
            continue
        if in_protos and not buf and re.fullmatch(r'[A-Z_0-9 ]+', st):
            continue
        if in_protos or buf or '(' in st or st.endswith(';'):
            in_protos = True
            buf = (buf + ' ' + st).strip()
            if buf.endswith(';'):
                protos.append((hdr, buf))
                buf = ''
            continue
        if stop_idents:
            continue
        toks = st.split()
        i = 0
        while i < len(toks):
            t = toks[i]
            if t in ('struct', 'union'):
                idents.append((hdr, t + ' ' + toks[i + 1])); i += 2; continue
            if N_PATTERN.match(t):
                for n in ('8', '16', '32', '64'):
                    idents.append((hdr, re.sub(r'N(?=_|$)', n, t, count=1)))
            else:
                idents.append((hdr, t))
            i += 1

PLACEHOLDER = re.compile(r'type\d|real-floating|generic_|QChar|QVoid|_Decimal|\bA\b|\bC\b|\bM\b|\btype\b|\bT\b|_s\(|[a-z]+-[a-z]+')
# Object types that may be incomplete (C23 6.2.5p1: FILE need only be an object type)
INCOMPLETE = {'FILE'}
# Identifiers that need a compiler feature some supported compilers lack (PLAN D127): checked only where the
# compiler predefines the macro that shows the feature (GCC 14 and 15 have no _BitInt on 32-bit Arm)
COMPILER_FEATURE = {'BITINT_MAXWIDTH': '__BITINT_MAXWIDTH__'}
MACRO_ONLY = {'assert', 'setjmp', 'va_start', 'va_arg', 'va_end', 'va_copy', 'offsetof', 'unreachable', 'kill_dependency', 'ATOMIC_VAR_INIT', 'CMPLX', 'CMPLXF', 'CMPLXL'}
lines = [HEADER]
lines.append('/*\n * Generated from the C23 Annex B (N3220, docs/standard/annex-b.pdf) by\n * tools/scripts/annexb-audit (PLAN D50); regenerate rather than edit. The\n * test passes when it compiles: every identifier of the in-scope headers\n * exists, every function has the Annex B type.\n */\n\n')
lines.append('#define __STDC_WANT_IEC_60559_EXT__\n')
for h in headers:
    lines.append(f'#include <{h}>\n')
lines.append('\n#include <stddef.h>\n\n')
count_i = 0
lines.append('/* Every macro, type and constant: defined as a macro, or else usable in sizeof */\n')
seen = set()
for h, i in idents:
    if (h, i) in seen or CONDITIONAL.match(i) or i in MACRO_ONLY:
        continue
    seen.add((h, i))
    count_i += 1
    if ' ' in i:
        lines.append(f'static_assert(sizeof({i}) > 0, "<{h}> {i}");\n')
    elif i in INCOMPLETE:
        lines.append(f'static_assert(sizeof({i} *) > 0, "<{h}> {i}");\n')
    elif i in COMPILER_FEATURE:
        lines.append(f'#if !defined({i}) && defined({COMPILER_FEATURE[i]})\nstatic_assert(sizeof({i}) > 0, "<{h}> {i}");\n#endif\n')
    else:
        lines.append(f'#ifndef {i}\nstatic_assert(sizeof({i}) > 0, "<{h}> {i}");\n#endif\n')
count_p = 0
lines.append('\n/* Every function, redeclared with its Annex B type (a mismatch does not compile); the parentheses bypass masking macros */\n')
for h, p in protos:
    p = re.sub(r'\[\[[a-z_]+\]\]', '', p).strip()
    p = re.sub(r'\s+', ' ', p).replace(' ;', ';')
    m = re.search(r'([A-Za-z_][A-Za-z0-9_]*)\(', p)
    if not m or PLACEHOLDER.search(p) or m.group(1) in MACRO_ONLY:
        skipped.append(p)
        continue
    name = m.group(1)
    p = p[:m.start(1)] + '(' + name + ')' + p[m.end(1):]
    lines.append(p + '\n')
    count_p += 1
lines.append('\n/* The generic functions and function-like macros (placeholder types in Annex B): defined as macros, or else declared */\n')
count_g = 0
seen_g = set()
for p in skipped:
    if re.search(r'_Decimal|_s\(|\bd(32|64|128)\b|d(32|64|128)\(', p):
        continue
    m = re.search(r'([A-Za-z_][A-Za-z0-9_]*)\(', p)
    if not m:
        continue
    names = [m.group(1)]
    if 'fetch_key' in names[0]:
        names = [names[0].replace('key', k) for k in ('add', 'sub', 'or', 'xor', 'and')]
    for name in names:
        if name in seen_g:
            continue
        seen_g.add(name)
        count_g += 1
        lines.append(f'#ifndef {name}\nstatic_assert(sizeof(&({name})) > 0, "{name}");\n#endif\n')
lines.append('\nint main(void)\n{\n\treturn 0;\n}\n')
open(OUT, 'w').write(''.join(lines))
# The project's layout (CLAUDE.md): the committed file is clang-format output
subprocess.run(['clang-format', '-i', OUT], check=True)
print(f'{len(headers)} headers, {count_i} identifiers, {count_p} prototypes, {count_g} generic names', file=sys.stderr)
