# Usage: tools/scripts/size-baseline [build type]   (from the project root, after "make")
# Prints the phase-1 size baseline as Markdown (docs/size/phase-1.md, PLAN D50):
# per board, the text/data/bss totals of libc.a and of example/hello-world.
# Phase 2 replaces this with tools/size-report (per member, stack use).

set -euo pipefail

type=${1:-release}
boards=(linux-x86_64 linux-armv6-m linux-armv6s-m linux-armv7e-m linux-armv7e-m-dp linux-armv8-m.main)

size_tool() {
	if [[ $1 == linux-x86_64 ]]; then
		echo size
	else
		echo "${PROJECT_ROOT:-.}/local/bin/arm-none-eabi-size"
	fi
}

# text data bss of the files given, summed
totals() {
	local tool=$1
	shift
	"${tool}" "$@" | awk 'NR > 1 && $1 ~ /^[0-9]+$/ { t += $1; d += $2; b += $3 } END { printf "%d %d %d", t, d, b }'
}

echo "| Board | libc.a text | libc.a data | libc.a bss | hello-world text | hello-world data | hello-world bss |"
echo "|---|---:|---:|---:|---:|---:|---:|"
for board in "${boards[@]}"; do
	root=build/${board}/${type}
	tool=$(size_tool "${board}")
	read -r lt ld lb <<< "$(totals "${tool}" "${root}/libc/libc.a")"
	read -r ht hd hb <<< "$(totals "${tool}" "${root}/example/hello-world/hello-world.elf")"
	echo "| ${board} | ${lt} | ${ld} | ${lb} | ${ht} | ${hd} | ${hb} |"
done
