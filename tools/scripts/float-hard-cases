# float-hard-cases
#
# Created on: Oct 22, 2026
#     Author: Stephen Street (stephen@redrocketcomputing.com)
#
# The exhaustive search for the float functions' hard cases on the double
# path (PLAN D98, docs/research/float-hard-cases.md): builds
# tools/libm/float_hard_cases.c against the x86_64 release libc.a (every
# symbol prefixed rt_) and runs it. Needs the host MPFR development files
# (libmpfr-dev). Run from the project root after an x86_64 release build:
#
#   tools/scripts/float-hard-cases [FUNCTION ...]   search every unary float function, or those named
#                                                   (e.g. expf); prints every argument rounded wrongly and
#                                                   exits 1 if there is one
#
# About a minute per function on four threads; the 36 functions take about
# 40 minutes. A clean run is the check behind D98's claim that the double
# path is correctly rounded.

import os
import subprocess
import sys

WORK = os.path.join('build', 'linux-x86_64', 'libm-hard-cases')


def run(command):
	result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
	if result.returncode != 0:
		raise SystemExit(' '.join(command) + '\n' + result.stdout)
	return result.stdout


def main():
	library = os.path.join('build', 'linux-x86_64', 'release', 'libc', 'libc.a')
	if not os.path.exists(library):
		raise SystemExit(f'{library}: missing; build it first (make BOARD_TYPE=linux-x86_64 BUILD_TYPE=release)')
	os.makedirs(WORK, exist_ok=True)
	prefixed = os.path.join(WORK, 'librt.a')
	run(['cp', library, prefixed])
	run(['objcopy', '--prefix-symbols=rt_', prefixed])
	program = os.path.join(WORK, 'float_hard_cases')
	run(['gcc-14', '-std=c23', '-O2', '-Wall', '-Werror', '-no-pie', '-o', program, os.path.join('tools', 'libm', 'float_hard_cases.c'), prefixed, '-lmpfr', '-lgmp', '-lm', '-lpthread'])
	wrong = 0
	with subprocess.Popen([program] + sys.argv[1:], stdout=subprocess.PIPE, text=True) as search:
		for line in search.stdout:
			sys.stdout.write(line)
			sys.stdout.flush()
			if not line.startswith('done '):
				wrong += 1
	if search.returncode != 0:
		raise SystemExit(f'{program}: exit status {search.returncode}')
	print(f'{wrong} argument(s) rounded wrongly')
	return 1 if wrong else 0


if __name__ == '__main__':
	sys.exit(main())
